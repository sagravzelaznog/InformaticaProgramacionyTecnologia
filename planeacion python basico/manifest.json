  "shortcuts": [
    {
      "name": "Ver progreso",
      "short_name": "Progreso",
      "description": "Ver tu progreso en el curso",
      "url": "/?tab=progress",
      "icons": [
        {
          "src": "/assets/images/shortcut-progress.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Recursos",
      "short_name": "Recursos",
      "description": "Acceder a recursos adicionales",
      "url": "/?tab=resources",
      "icons": [
        {
          "src": "/assets/images/shortcut-resources.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Sesión actual",
      "short_name": "Continuar",
      "description": "Continuar con la sesión actual",
      "url": "/sessions/current",
      "icons": [
        {
          "src": "/assets/images/shortcut-continue.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://python-course.app/manifest.json"
    }
  ],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "capture_links": "new-client",
  "protocol_handlers": [
    {
      "protocol": "web+python-course",
      "url": "/?session=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/open-python-file",
      "accept": {
        "text/x-python": [".py"],
        "application/x-python": [".py"]
      }
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "python-files",
          "accept": ["text/x-python", ".py"]
        }
      ]
    }
  },
  "features": [
    "Cross Platform",
    "fast",
    "simple"
  ],
  "developer": {
    "name": "JGMV-PTEL",
    "url": "https://github.com/jgmv-ptel/python-course"
  },
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7"
}











